# ==============================================================================
# HELPDESK USER SERVICE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Server Configuration
PORT=8081

# Database Configuration (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=user_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_database_password
DATABASE_URL=jdbc:postgresql://localhost:5433/user_db

# Security (JWT) - Chave secreta de no mínimo 256 bits (HMAC-SHA)
JWT_SECRET=your_jwt_secret_key_here_min_256_bits_base64_or_hex
JWT_EXPIRATION_MS=86400000

